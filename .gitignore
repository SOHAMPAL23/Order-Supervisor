# ─── Order Supervisor POC — Root .gitignore ───────────────────────────────────

# ── Environment / Secrets ──────────────────────────────────────────────────────
.env
.env.local
.env.*.local
# Keep .env.example files so contributors know what variables are needed
!.env.example

# ── Python / Backend ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
ENV/

# Pytest
.pytest_cache/
.coverage
htmlcov/
*.coveragerc

# Mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json

# Alembic (keep migrations, ignore cache)
backend/migrations/__pycache__/

# ── Node / Frontend ────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
frontend/coverage/
*.tsbuildinfo
frontend/next-env.d.ts

# ── Editor / OS ────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pip-log.txt

# ── Docker ─────────────────────────────────────────────────────────────────────
# Keep docker-compose.yml and Dockerfile — ignore local overrides
docker-compose.override.yml

# ── Misc ───────────────────────────────────────────────────────────────────────
*.pem
*.key
*.crt
.vercel
